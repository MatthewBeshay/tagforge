root = true

[*]
indent_style = tab
indent_size = 8
tab_width = 8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8
max_line_length = 120

[*.{cmake,yml,yaml,json,md}]
indent_style = space
indent_size = 4

[CMakeLists.txt]
indent_style = space
indent_size = 4
